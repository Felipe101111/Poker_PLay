generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Session storage is managed by connect-pg-simple (its own auto-created
// "session" table: sid/sess/expire) — see backend/src/app.ts. The conceptual
// Session entity from data-model.md (id, userId, createdAt, expiresAt) maps to
// that table's sid/sess(JSON: userId, createdAt)/expire columns respectively.
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  // Original casing preserved for display; uniqueness is enforced case/whitespace
  // -insensitively via the shadow `usernameNormalized` column (data-model.md FR-003/FR-011).
  username           String
  usernameNormalized String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())

  sentFriendRequests      FriendRequest[]      @relation("Sender")
  receivedFriendRequests  FriendRequest[]      @relation("Receiver")
  friendRequestsAsLow     FriendRequest[]      @relation("UserLow")
  friendRequestsAsHigh    FriendRequest[]      @relation("UserHigh")
  hostedRooms             PokerRoom[]          @relation("RoomHost")
  roomMemberships         RoomMember[]
  sentRoomInvitations     RoomInvitation[]     @relation("InvitationSender")
  receivedRoomInvitations RoomInvitation[]     @relation("InvitationRecipient")
  tableParticipants       TableParticipant[]
  tableActions            TableAction[]
  createdMultiplayerTrainingSessions MultiplayerTrainingSession[] @relation("MultiplayerTrainingSessionCreator")
  multiplayerTrainingParticipants MultiplayerTrainingParticipant[]
  multiplayerTrainingDecisions MultiplayerTrainingDecision[]
  trainingSessions        TrainingSession[]
  trainingDecisions       TrainingDecision[]
  equityStrategySnapshots EvaluationSnapshot[]
  historyPolicies         HistoryAccessPolicy[]
  historyParticipants     HandHistoryParticipant[]
  createdStrategyVersions  StrategyDatasetVersion[] @relation("StrategyVersionCreatedBy")
  publishedStrategyVersions StrategyDatasetVersion[] @relation("StrategyVersionPublishedBy")
  retiredStrategyVersions  StrategyDatasetVersion[] @relation("StrategyVersionRetiredBy")
  editorialAuditEntries    EditorialAuditEntry[]
  publicationRecords       PublicationRecord[]
  editorialRole             EditorialRole @default(USER)

  @@map("users")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

// One row per unordered user pair (data-model.md 002-friends-system). Reject/cancel/remove
// physically delete the row instead of persisting a terminal status — see research.md.
model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  userLowId  String
  userHighId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  userLow  User @relation("UserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("UserHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@map("friend_requests")
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  WAITING
  STARTED
  CLOSED
}

enum RoomInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  INVALIDATED
}

model PokerRoom {
  id              String         @id @default(uuid())
  hostId          String
  name            String
  visibility      RoomVisibility
  status          RoomStatus     @default(WAITING)
  seatLimit       Int
  minPlayers      Int
  startingStackBB Int
  smallBlind      Int
  bigBlind        Int
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startedAt       DateTime?
  closedAt        DateTime?

  host             User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members          RoomMember[]
  invitations      RoomInvitation[]
  multiplayerTable MultiplayerTable?

  @@index([status, visibility, createdAt])
  @@map("poker_rooms")
}

model RoomMember {
  id         String   @id @default(uuid())
  roomId     String
  userId     String   @unique
  seatNumber Int
  ready      Boolean  @default(false)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())

  room             PokerRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tableParticipant TableParticipant?

  @@unique([roomId, userId])
  @@unique([roomId, seatNumber])
  @@index([roomId, joinedAt])
  @@map("room_members")
}

enum MultiplayerTableStatus {
  ACTIVE
  CLOSED
}

enum MultiplayerHandStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ParticipantConnectionStatus {
  ONLINE
  DISCONNECTED
  ELIMINATED
}

enum MultiplayerActionType {
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALL_IN
}

model MultiplayerTable {
  id            String                 @id @default(uuid())
  roomId        String                 @unique
  status        MultiplayerTableStatus @default(ACTIVE)
  handNumber    Int                    @default(1)
  currentHandId String?                @unique
  dealerSeat    Int
  stateVersion  Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  closedAt      DateTime?

  room         PokerRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  currentHand  MultiplayerHand?   @relation("CurrentTableHand", fields: [currentHandId], references: [id])
  hands        MultiplayerHand[]  @relation("TableHands")
  participants TableParticipant[]
  trainingSession MultiplayerTrainingSession?

  @@index([status, updatedAt])
  @@map("multiplayer_tables")
}

model TableParticipant {
  id                  String                      @id @default(uuid())
  tableId             String
  userId              String
  roomMemberId        String?                     @unique
  seatNumber          Int
  stack               Int
  eligibleForNextHand Boolean                     @default(true)
  connectionStatus    ParticipantConnectionStatus @default(DISCONNECTED)
  lastSeenAt          DateTime                    @default(now())
  disconnectedAt      DateTime?
  eliminatedAt        DateTime?

  table      MultiplayerTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomMember RoomMember?      @relation(fields: [roomMemberId], references: [id], onDelete: SetNull)
  trainingParticipant MultiplayerTrainingParticipant?

  @@unique([tableId, userId])
  @@unique([tableId, seatNumber])
  @@index([tableId, eligibleForNextHand])
  @@index([connectionStatus, disconnectedAt])
  @@map("table_participants")
}

model MultiplayerHand {
  id             String                @id @default(uuid())
  tableId        String
  handNumber     Int
  status         MultiplayerHandStatus @default(ACTIVE)
  stateSnapshot  Json
  stateVersion   Int                   @default(1)
  actingSeat     Int?
  startedAt      DateTime              @default(now())
  completedAt    DateTime?
  resultSnapshot Json?

  table      MultiplayerTable  @relation("TableHands", fields: [tableId], references: [id], onDelete: Cascade)
  currentFor MultiplayerTable? @relation("CurrentTableHand")
  actions    TableAction[]
  trainingDecisions MultiplayerTrainingDecision[]

  @@unique([tableId, handNumber])
  @@index([tableId, status])
  @@map("multiplayer_hands")
}

model TableAction {
  id               String                @id @default(uuid())
  handId           String
  requestId        String
  sequence         Int
  userId           String
  seatNumber       Int
  actionType       MultiplayerActionType
  amount           Int?
  accepted         Boolean
  rejectionCode    String?
  resultingVersion Int?
  createdAt        DateTime              @default(now())

  hand MultiplayerHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingDecision MultiplayerTrainingDecision?

  @@unique([handId, userId, requestId])
  @@unique([handId, sequence])
  @@index([handId, createdAt])
  @@map("table_actions")
}

enum TrainingSessionFormat {
  SIX_MAX_100BB_PREFLOP
  SIX_MAX_100BB_POSTFLOP
}

enum TrainingStreet {
  PREFLOP
  FLOP
  TURN
  RIVER
}

enum TrainingTerminalReason {
  FOLD
  ALL_IN
  SHOWDOWN
  COMPLETE
}

enum TrainingSessionStatus {
  ACTIVE
  COMPLETED
}

enum TrainingEvaluationStatus {
  EVALUATED
  UNAVAILABLE
}

enum TrainingEvaluationCategory {
  PREFERRED
  ACCEPTABLE_MIXED
  MARGINAL
  SIGNIFICANT_DEVIATION
}

enum MultiplayerTrainingSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MultiplayerTrainingParticipantStatus {
  ENROLLED
  LEFT
  REMOVED
}

model MultiplayerTrainingSession {
  id          String                            @id @default(uuid())
  tableId     String                            @unique
  format      TrainingSessionFormat             @default(SIX_MAX_100BB_PREFLOP)
  status      MultiplayerTrainingSessionStatus  @default(ACTIVE)
  createdById String
  createdAt   DateTime                          @default(now())
  completedAt DateTime?

  table        MultiplayerTable                @relation(fields: [tableId], references: [id], onDelete: Cascade)
  createdBy    User                             @relation("MultiplayerTrainingSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  participants MultiplayerTrainingParticipant[]
  decisions    MultiplayerTrainingDecision[]

  @@index([status, createdAt])
  @@map("multiplayer_training_sessions")
}

model MultiplayerTrainingParticipant {
  id                 String                               @id @default(uuid())
  trainingSessionId  String
  tableParticipantId String                               @unique
  userId             String
  status             MultiplayerTrainingParticipantStatus @default(ENROLLED)
  joinedAt           DateTime                             @default(now())
  leftAt             DateTime?

  trainingSession  MultiplayerTrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  tableParticipant TableParticipant           @relation(fields: [tableParticipantId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions        MultiplayerTrainingDecision[]

  @@unique([trainingSessionId, tableParticipantId])
  @@unique([trainingSessionId, userId])
  @@index([userId, status])
  @@map("multiplayer_training_participants")
}

model MultiplayerTrainingDecision {
  id                      String                        @id @default(uuid())
  trainingSessionId       String
  participantId           String
  handId                  String
  tableActionId           String                        @unique
  userId                  String
  sequence                Int
  street                  TrainingStreet
  decisionContextSnapshot Json
  selectedAction          Json
  evaluationStatus        TrainingEvaluationStatus
  category                TrainingEvaluationCategory?
  equitySnapshot          Json
  strategyVersionSnapshot Json?
  strategyRowSnapshot     Json?
  explanationSnapshot     Json
  calculationFingerprint  String?
  createdAt               DateTime                      @default(now())

  trainingSession    MultiplayerTrainingSession     @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  participant        MultiplayerTrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  hand               MultiplayerHand               @relation(fields: [handId], references: [id], onDelete: Cascade)
  tableAction        TableAction                   @relation(fields: [tableActionId], references: [id], onDelete: Cascade)
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluationSnapshot EvaluationSnapshot?

  @@unique([handId, userId, sequence])
  @@index([trainingSessionId, userId, createdAt])
  @@index([participantId, createdAt])
  @@map("multiplayer_training_decisions")
}

model TrainingSession {
  id                String                @id @default(uuid())
  userId            String
  format            TrainingSessionFormat @default(SIX_MAX_100BB_PREFLOP)
  status            TrainingSessionStatus @default(ACTIVE)
  currentScenarioId String?               @unique
  startedAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  completedAt       DateTime?

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentScenario TrainingScenario?  @relation("CurrentTrainingScenario", fields: [currentScenarioId], references: [id])
  scenarios       TrainingScenario[] @relation("SessionScenarios")

  @@index([userId, status])
  @@map("training_sessions")
}

model TrainingScenario {
  id               String   @id @default(uuid())
  sessionId        String
  sequence         Int
  generationSeed   Int
  engineSnapshot   Json
  holeCards        Json
  position         String
  tableSize        Int
  effectiveStackBB Int
  blindContext     Json
  priorActions     Json
  legalActions     Json
  strategyKey      String
  strategyVersion  String?
  street           TrainingStreet?
  board            Json?
  potBB            Float?
  terminalReason   TrainingTerminalReason?
  createdAt        DateTime @default(now())

  session    TrainingSession    @relation("SessionScenarios", fields: [sessionId], references: [id], onDelete: Cascade)
  currentFor TrainingSession?   @relation("CurrentTrainingScenario")
  decisions  TrainingDecision[]

  @@unique([sessionId, sequence])
  @@index([sessionId, createdAt])
  @@map("training_scenarios")
}

model TrainingDecision {
  id                     String                      @id @default(uuid())
  scenarioId             String
  userId                 String
  selectedAction         Json
  evaluationStatus       TrainingEvaluationStatus
  category               TrainingEvaluationCategory?
  recommendationSnapshot Json?
  explanationSnapshot    Json
  strategyVersion        String?
  completedAt            DateTime                    @default(now())
  requestId              String

  scenario TrainingScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, userId])
  @@unique([scenarioId, userId, requestId])
  @@index([userId, completedAt])
  @@map("training_decisions")
}

model RoomInvitation {
  id         String               @id @default(uuid())
  roomId     String
  fromUserId String
  toUserId   String
  status     RoomInvitationStatus @default(PENDING)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  room     PokerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromUser User      @relation("InvitationSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User      @relation("InvitationRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, toUserId])
  @@index([toUserId, status, createdAt])
  @@map("room_invitations")
}

enum StrategyDatasetStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum EditorialRole {
  USER
  EDITOR
  REVIEWER
  PUBLISHER
  ADMIN
}

model StrategyDataset {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions StrategyDatasetVersion[]

  @@map("strategy_datasets")
}

model StrategyDatasetVersion {
  id               String                @id @default(uuid())
  datasetId        String
  version          String
  schemaVersion    String
  gameFormat       String
  street           String
  tableSize        Int
  stackAssumptions Json
  blindAssumptions Json
  source           String
  contentHash      String?
  assumptions      Json
  precision        Decimal               @db.Decimal(12, 10)
  status           StrategyDatasetStatus @default(PUBLISHED)
  compatibilityKey String
  activeCompatibilityKey String?          @unique
  revision         Int                   @default(0)
  validationReport Json?
  createdById      String?
  publishedById    String?
  retiredById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  publishedAt      DateTime?
  retiredAt        DateTime?

  dataset   StrategyDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdBy User? @relation("StrategyVersionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User? @relation("StrategyVersionPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  retiredBy User? @relation("StrategyVersionRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  rows      StrategyRow[]
  snapshots EvaluationSnapshot[]
  publicationRecords PublicationRecord[]

  @@unique([datasetId, version])
  @@index([gameFormat, street, status])
  @@index([datasetId, status, createdAt])
  @@index([compatibilityKey, status])
  @@map("strategy_dataset_versions")
}

model StrategyRow {
  id               String @id @default(uuid())
  datasetVersionId String
  contextKey       String
  rangeSnapshot    Json?
  actions          Json
  factors          Json
  assumptions      Json
  conditions       Json

  datasetVersion StrategyDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, contextKey])
  @@map("strategy_rows")
}

model PublicationRecord {
  id                    String   @id @default(uuid())
  datasetVersionId      String
  actorId               String
  action                String
  reason                String?
  previousActiveVersionId String?
  createdAt             DateTime @default(now())

  datasetVersion StrategyDatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)
  actor          User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([datasetVersionId, createdAt])
  @@index([actorId, createdAt])
  @@map("strategy_publication_records")
}

model EditorialAuditEntry {
  id               String   @id @default(uuid())
  actorId          String?
  actorRole        EditorialRole
  action           String
  entityType       String
  entityId         String?
  requestId        String?
  expectedRevision Int?
  result           String
  reason           String?
  metadata         Json?
  createdAt        DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("editorial_audit_entries")
}

model EvaluationSnapshot {
  id                      String   @id @default(uuid())
  userId                  String
  scenarioId              String?
  datasetVersionId        String?
  contextSnapshot         Json
  equitySnapshot          Json
  strategyVersionSnapshot Json?
  strategyRowSnapshot     Json?
  classification          String?
  availability            String
  calculationFingerprint  String?
  multiplayerTrainingDecisionId String? @unique
  createdAt               DateTime @default(now())

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  datasetVersion StrategyDatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  multiplayerTrainingDecision MultiplayerTrainingDecision? @relation(fields: [multiplayerTrainingDecisionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([scenarioId, createdAt])
  @@map("evaluation_snapshots")
}

enum HandHistorySourceType {
  LOCAL_GAME
  MULTIPLAYER
  TRAINER
}

enum HandHistoryStatus {
  COMPLETED
  FOLDED
  ALL_IN
  ABANDONED
  ANONYMIZED
}

enum HandActionStreet {
  PREFLOP
  FLOP
  TURN
  RIVER
  SHOWDOWN
  TERMINAL
}

enum HandActionType {
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALL_IN
  BLIND
  DEAL
  SHOWDOWN
  TERMINAL
}

enum HandHistoryParticipantRole {
  PLAYER
  SPECTATOR
}

enum HandHistoryParticipantVisibility {
  PARTICIPANT
  AUTHORIZED_VIEWER
  ANONYMIZED
}

enum HistoryRedactionProfile {
  FULL_AUTHORIZED
  PUBLIC_ONLY
  ANONYMIZED
}

model HandHistory {
  id              String                @id @default(uuid())
  sourceType      HandHistorySourceType
  sourceId        String
  status          HandHistoryStatus
  format          String
  startedAt       DateTime
  endedAt         DateTime
  sequenceVersion Int                   @default(1)
  publicSnapshot  Json
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  participants HandHistoryParticipant[]
  actions      HandAction[]
  policies     HistoryAccessPolicy[]

  @@unique([sourceType, sourceId])
  @@index([endedAt, id])
  @@index([format, status, endedAt])
  @@map("hand_histories")
}

model HandHistoryParticipant {
  id                  String                              @id @default(uuid())
  historyId           String
  userId              String?
  seatNumber          Int
  displayNameSnapshot String?
  role                HandHistoryParticipantRole          @default(PLAYER)
  visibility          HandHistoryParticipantVisibility    @default(PARTICIPANT)

  history HandHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([historyId, seatNumber])
  @@index([userId, historyId])
  @@map("hand_history_participants")
}

model HandAction {
  id             String          @id @default(uuid())
  historyId      String
  sequence       Int
  street         HandActionStreet
  seatNumber     Int?
  actionType     HandActionType
  amount         Int?
  publicStateAfter Json
  occurredAt     DateTime

  history HandHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)

  @@unique([historyId, sequence])
  @@index([historyId, sequence])
  @@map("hand_actions")
}

model HistoryAccessPolicy {
  id                String                 @id @default(uuid())
  historyId         String
  userId            String
  canList           Boolean                @default(true)
  canViewDetail     Boolean                @default(true)
  canRequestRemoval Boolean                @default(true)
  redactionProfile  HistoryRedactionProfile @default(FULL_AUTHORIZED)
  anonymizedAt      DateTime?

  history HandHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([historyId, userId])
  @@index([userId, canList, historyId])
  @@map("history_access_policies")
}
