generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Session storage is managed by connect-pg-simple (its own auto-created
// "session" table: sid/sess/expire) — see backend/src/app.ts. The conceptual
// Session entity from data-model.md (id, userId, createdAt, expiresAt) maps to
// that table's sid/sess(JSON: userId, createdAt)/expire columns respectively.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Original casing preserved for display; uniqueness is enforced case/whitespace
  // -insensitively via the shadow `usernameNormalized` column (data-model.md FR-003/FR-011).
  username           String
  usernameNormalized String   @unique
  passwordHash       String
  createdAt          DateTime @default(now())

  sentFriendRequests     FriendRequest[] @relation("Sender")
  receivedFriendRequests FriendRequest[] @relation("Receiver")
  friendRequestsAsLow    FriendRequest[] @relation("UserLow")
  friendRequestsAsHigh   FriendRequest[] @relation("UserHigh")

  @@map("users")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
}

// One row per unordered user pair (data-model.md 002-friends-system). Reject/cancel/remove
// physically delete the row instead of persisting a terminal status — see research.md.
model FriendRequest {
  id         String              @id @default(uuid())
  senderId   String
  receiverId String
  userLowId  String
  userHighId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  userLow  User @relation("UserLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh User @relation("UserHigh", fields: [userHighId], references: [id], onDelete: Cascade)

  @@unique([userLowId, userHighId])
  @@map("friend_requests")
}
